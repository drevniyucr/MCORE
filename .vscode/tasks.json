{
    "tasks": [
        {
            "label": "CMake Clean",
            "type": "shell",
            "command": "cmake",
            "group": "build",
            "problemMatcher": [],
            "args": [
                "--build",
                "${workspaceFolder}/build-f767",
                "--target",
                "clean"
            ]
        },
        {
            "args": [
                "-G",
                "Ninja",
                "-S",
                "${workspaceFolder}/projects/stm32f767",
                "-B",
                "${workspaceFolder}/build-f767",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "command": "cmake",
            "label": "CMake Configure",
            "problemMatcher": [],
            "type": "shell"
        },
        {
            "args": [
                "--build",
                "${workspaceFolder}/build-f767",
                "--target",
                "STM32F767"
            ],
            "command": "cmake",
            "dependsOn": [
                "CMake Clean"
            ],
            "dependsOrder": "sequence",
            "label": "CMake Build",
            "problemMatcher": [
                "$gcc"
            ],
            "type": "shell"
        },
        {
            "args": [
                "-O",
                "binary",
                "${workspaceFolder}\\build-f767\\STM32F767",
                "${workspaceFolder}\\build-f767\\STM32F767.bin"
            ],
            "command": "arm-none-eabi-objcopy.exe",
            "dependsOn": "CMake Build",
            "label": "Generate BIN",
            "problemMatcher": [],
            "type": "shell"
        },
        {
            "args": [
                "${workspaceFolder}\\build-f767\\STM32F767"
            ],
            "command": "arm-none-eabi-size.exe",
            "dependsOn": "Generate BIN",
            "label": "View Firmware Size",
            "problemMatcher": [],
            "type": "shell"
        },
        {
            "args": [
                "-f",
                "interface/stlink.cfg",
                "-f",
                "target/stm32f7x.cfg",
                "-c",
                "init; reset halt; stm32f7x mass_erase 0; reset; exit"
            ],
            "command": "openocd",
            "label": "Erase MCU",
            "problemMatcher": [],
            "type": "shell"
        },
        {
            "args": [
                "-f",
                "interface/stlink.cfg",
                "-f",
                "target/stm32f7x.cfg",
                "-c",
                "program ${workspaceFolder}/build-f767/STM32F767.bin 0x08000000 verify reset exit"
            ],
            "command": "openocd",
            "label": "Flash MCU",
            "problemMatcher": [],
            "type": "shell"
        },
        {
            "command": "echo Automatic workflow running...",
            "dependsOn": [
                "CMake Build",
                "Generate BIN",
                "Erase MCU",
                "Flash MCU",
                "View Firmware Size"
            ],
            "dependsOrder": "sequence",
            "label": "Build + Flash + Size",
            "problemMatcher": [],
            "type": "shell"
        },
        {
            // clangd index: configure every build (compile_commands.json) and
            // merge them into build-index/ (cmake/compile_db.py, read by .clangd).
            // Run once after a checkout and after adding/removing source files.
            "label": "Index: update",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/cmake/compile_db.py"],
            "dependsOn": ["Index: configure H755", "Index: configure F767", "Index: configure tests"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Index: configure H755",
            "type": "shell",
            "command": "cmake",
            "args": ["-G", "Ninja", "-S", "${workspaceFolder}/projects/stm32h755", "-B", "${workspaceFolder}/build-h7",
                     "-DCMAKE_BUILD_TYPE=Debug"],
            "problemMatcher": []
        },
        {
            "label": "Index: configure F767",
            "type": "shell",
            "command": "cmake",
            "args": ["-G", "Ninja", "-S", "${workspaceFolder}/projects/stm32f767", "-B", "${workspaceFolder}/build-f767",
                     "-DCMAKE_BUILD_TYPE=Debug"],
            "problemMatcher": []
        },
        {
            "label": "Index: configure tests",
            "type": "shell",
            "command": "cmake",
            "args": ["-G", "Ninja", "-S", "${workspaceFolder}/tests", "-B", "${workspaceFolder}/build-tests"],
            "problemMatcher": []
        },
        {
            "label": "H755: CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-G", "Ninja",
                "-S", "${workspaceFolder}/projects/stm32h755",
                "-B", "${workspaceFolder}/build-h7",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            // Builds both images: STM32H755 (Cortex-M7) and STM32H755_CM4
            "label": "H755: CMake Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build-h7"
            ],
            "problemMatcher": ["$gcc"]
        },
        {
            // Erases BOTH banks: bank 2 holds the Cortex-M4 image (on a new
            // NUCLEO-H755ZI-Q that is ST's demo, which drives LEDs on PB0/PE1/PB14).
            "label": "H755: Erase MCU (both banks)",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-s", "${workspaceFolder}/debug/openocd",
                "-f", "${workspaceFolder}/debug/MCORE_Debug_H755.cfg",
                "-c", "init; reset halt; stm32h7x mass_erase 0; stm32h7x mass_erase 1; reset; exit"
            ],
            "problemMatcher": []
        },
        {
            "label": "H755: Flash MCU",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-s", "${workspaceFolder}/debug/openocd",
                "-f", "${workspaceFolder}/debug/MCORE_Debug_H755.cfg",
                "-c", "program ${workspaceFolder}/build-h7/STM32H755.bin 0x08000000 verify",
                "-c", "program ${workspaceFolder}/build-h7/STM32H755_CM4.bin 0x08100000 verify reset exit"
            ],
            "dependsOn": "H755: CMake Build",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++.exe сборка активного файла",
            "command": "clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Задача создана отладчиком."
        }
    ],
    "version": "2.0.0"
}
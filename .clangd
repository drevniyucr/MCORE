CompileFlags:
  # all builds merged by cmake/compile_db.py (task "Index: update")
  CompilationDatabase: build-index
  Add:
    - -Wno-unknown-attributes
    - -Wno-unused-template
    - -Wno-unused-member-function
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
Index:
  Background: Build
InlayHints:
  Enabled: false
